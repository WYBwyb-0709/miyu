{
  "name": "miyu",
  "version": "1.0.0",
  "private": true,
  "description": "密语 · 去中心化私密聊天（Windows / Android / PWA）",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "vendor": "node scripts/build-vendor.mjs",
    "serve": "node scripts/static-server.mjs",
    "relay": "node relay/src/server.js",
    "test:relay": "node scripts/test-relay.mjs",
    "test:browser": "node tests/smoke.mjs",
    "test:desktop": "node tests/desktop-smoke.mjs",
    "test": "node scripts/test-relay.mjs && node tests/smoke.mjs",
    "android:sync": "cap sync android"
  },
  "keywords": [
    "chat",
    "nostr",
    "electron",
    "capacitor",
    "pwa"
  ],
  "author": "Miyu",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "commonjs",
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "nostr-tools": "^2.25.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "playwright-core": "^1.64.1"
  }
}
